{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android:dev": "APP_VARIANT=development expo run:android --device",
    "android:prod": "APP_VARIANT=production expo run:android --device --variant release",
    "prebuild:ios": "expo prebuild --clean --platform ios --no-install && cd ios && pod install --no-repo-update",
    "ios:dev": "APP_VARIANT=development expo run:ios --device",
    "ios:prod": "APP_VARIANT=production expo run:ios --device --configuration Release",
    "update-pods": "cd ios && pod install --repo-update",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "^57.0.0",
    "expo-asset": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.10",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.4.0",
    "lucide-react-native": "^0.556.0",
    "moti": "^0.30.0",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.12",
    "react-native": "0.86.2",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.1",
    "sonner-native": "^0.27.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "baseline-browser-mapping": "^2.10.32",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.18",
    "typescript": "~6.0.3"
  },
  "private": true
}
